{
  "name": "fatoorti-ios",
  "version": "1.0.0",
  "private": true,
  "description": "فاتورتي — تطبيق آيفون (Capacitor)",
  "scripts": {
    "build": "rm -rf www && mkdir -p www && cp ../index.html ../manifest.json ../privacy.html ../support.html www/ && cp -r ../fonts ../icons www/",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#1b2f6e' --splashBackgroundColor '#1b2f6e' --splashBackgroundColorDark '#0a0f1f'"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "cordova-plugin-purchase": "^13.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
